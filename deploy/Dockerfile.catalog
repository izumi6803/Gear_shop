# Catalog API — Dockerfile độc lập (dùng cho Railway/Render/Fly).
# Build từ thư mục gốc repo: docker build -f deploy/Dockerfile.catalog -t stockflow-catalog .

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
# global.json pin SDK 8.0.416 — bỏ để build được trong image SDK khác bản.
RUN rm -f global.json \
    && dotnet publish "src/Services/Catalog/StockFlow.Inventory.Catalog.Api/StockFlow.Inventory.Catalog.Api.csproj" \
       -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app .

ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    Database__Provider=Sqlite \
    Database__AutoCreate=true \
    ConnectionStrings__CatalogDb="Data Source=/data/catalog.db"

RUN mkdir -p /data
EXPOSE 8080
ENTRYPOINT ["dotnet", "StockFlow.Inventory.Catalog.Api.dll"]
