  "cards": [
    {
      "dot": "cyan",
      "title": "Storefront (user)",
      "items": [
        "Browse and search products with no account; prices and stock come from the Catalog API",
        "Cart lives in the browser until checkout",
        "Checkout creates the order and reserves stock immediately, so oversell is impossible",
        "Payment comes after the reservation; the shopper then follows the order in My orders"
      ]
    },
    {
      "dot": "emerald",
      "title": "Back office (staff)",
      "items": [
        "Admin: manage accounts (create, change role, disable) and read status/revenue",
        "Sales: create and update products, adjust stock, confirm and ship orders",
        "Viewer: read-only — sees orders and stock, no business actions",
        "Same APIs as the storefront; only the role in the JWT differs"
      ]
    },
    {
      "dot": "amber",
      "title": "Payment scope",
      "items": [
        "The provider edge is a sandbox: card data is validated (Luhn, expiry, CVV) and only a reference is stored",
        "No real charge, no PCI data at rest — a real gateway replaces one client call",
        "Ship is blocked until payment status is Paid"
      ]
    }
  ]
