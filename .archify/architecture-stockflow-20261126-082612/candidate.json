    {
      "dot": "emerald",
      "title": "Order lifecycle",
      "items": [
        "Draft → Confirmed reserves stock, Shipped issues stock and generates the invoice",
        "Cancel releases the reservation; a 409 shortage leaves the order in Draft",
        "Prices and product names are snapshotted into ORDER_LINE at creation"
      ]
    },
    {
      "dot": "cyan",
      "title": "Data ownership",
      "items": [
        "Each service owns its database; no foreign keys cross the boundary",
        "STOCK_MOVEMENT is append-only, so every quantity change is auditable",
        "Ordering never reads Catalog tables — it calls the API"
      ]
    },
    {
      "dot": "amber",
      "title": "Money and taxes",
      "items": [
        "10% tax computed on the server, rounded away from zero",
        "The client total is display-only; the server recomputes on save",
        "Invoice and seller profile are printed from the invoice endpoint"
      ]
