@page
@model IndexModel
@{
    ViewData["Title"] = "Tổng quan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Tổng quan</h1>
        <p class="text-muted mb-0 small">Xin chào @Model.Session.DisplayName — dữ liệu lấy trực tiếp từ Catalog &amp; Ordering API.</p>
    </div>
    @if (Model.Session.CanSell)
    {
        <a class="btn btn-primary" asp-page="/Orders/Create">+ Tạo đơn hàng</a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">order · Đơn hàng</div>
                <div class="stat-value">@Model.TotalOrders</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">product · Sản phẩm</div>
                <div class="stat-value">@Model.TotalProducts</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">invoice · Hoá đơn</div>
                <div class="stat-value">@Model.TotalInvoices</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Đơn hàng gần nhất</span>
        <a class="small" asp-page="/Orders/Index">Xem tất cả →</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
            <tr>
                <th>Số đơn</th>
                <th>Khách hàng</th>
                <th>Ngày</th>
                <th class="text-end">Tổng tiền</th>
                <th>Trạng thái</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.RecentOrders.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Chưa có đơn hàng nào.</td></tr>
            }
            @foreach (var order in Model.RecentOrders)
            {
                <tr>
                    <td class="fw-semibold">@order.OrderNo</td>
                    <td>@order.CustomerName</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@order.TotalAmount.ToString("N0") ¥</td>
                    <td><span class="badge @StatusBadge(order.Status)">@order.Status</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private static string StatusBadge(string status) => status switch
    {
        "Draft" => "text-bg-secondary",
        "Confirmed" => "text-bg-info",
        "Shipped" => "text-bg-success",
        "Cancelled" => "text-bg-danger",
        _ => "text-bg-light"
    };
}
