@inject UserSession UserSession
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · StockFlow Inventory</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar">
    <div class="container-fluid">
        <a class="navbar-brand" asp-page="/Index">
            <span class="brand-mark">FN</span>
            <span>StockFlow Inventory</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            @if (UserSession.IsAuthenticated)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Tổng quan</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Orders/Index">order · Đơn hàng</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Products/Index">product · Hàng hoá &amp; tồn kho</a></li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="user-chip">@UserSession.DisplayName <span class="badge text-bg-light">@UserSession.Role</span></span>
                    <a class="btn btn-sm btn-outline-light" asp-page="/Logout">Đăng xuất</a>
                </div>
            }
        </div>
    </div>
</nav>

<main class="container-fluid py-4">
    @if (TempData["Status"] is string status)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @status
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="app-footer">
    <div class="container-fluid d-flex justify-content-between small text-muted">
        <span>StockFlow Inventory — .NET 8 · ASP.NET Core · EF Core · SQL Server</span>
        <span>order & stock management (demo)</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
