@page
@model StockFlow.Inventory.Web.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Tạo đơn hàng";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Orders/Index">Đơn hàng</a></li>
        <li class="breadcrumb-item active">Tạo mới</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Tạo đơn hàng (draft)</h1>
    <span class="badge text-bg-secondary">Draft</span>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-body row g-3">
            <div class="col-md-5">
                <label class="form-label">Khách hàng <span class="text-danger">*</span></label>
                <select asp-for="CustomerId" class="form-select">
                    <option value="0">-- chọn khách hàng --</option>
                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">@customer.Code — @customer.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Ngày đặt (order date)</label>
                <input asp-for="OrderDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Ghi chú</label>
                <input asp-for="Note" class="form-control" placeholder="PO number, ghi chú giao hàng..." />
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Chi tiết hàng hoá</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="add-line">+ Thêm dòng</button>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="lines-table">
                <thead>
                <tr>
                    <th style="min-width: 320px">Hàng hoá</th>
                    <th style="min-width: 140px">Kho xuất</th>
                    <th style="width: 120px">Số lượng</th>
                    <th class="text-end" style="width: 140px">Thành tiền</th>
                    <th style="width: 60px"></th>
                </tr>
                </thead>
                <tbody id="lines-body">
                @for (var i = 0; i < Model.RowCount; i++)
                {
                    var line = i < Model.Lines.Count ? Model.Lines[i] : new StockFlow.Inventory.Web.Pages.Orders.CreateModel.LineInput();
                    <tr class="line-row">
                        <td>
                            <select name="Lines[@i].ProductId" class="form-select form-select-sm product-select">
                                <option value="0">-- chọn hàng hoá --</option>
                                @foreach (var product in Model.Products)
                                {
                                    if (product.Id == line.ProductId)
                                    {
                                        <option value="@product.Id" data-price="@product.UnitPrice" selected>@product.Code — @product.Name (@product.UnitPrice.ToString("N0") ¥)</option>
                                    }
                                    else
                                    {
                                        <option value="@product.Id" data-price="@product.UnitPrice">@product.Code — @product.Name (@product.UnitPrice.ToString("N0") ¥)</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>
                            <select name="Lines[@i].WarehouseId" class="form-select form-select-sm">
                                @foreach (var warehouse in Model.Warehouses)
                                {
                                    if (warehouse.Id == line.WarehouseId)
                                    {
                                        <option value="@warehouse.Id" selected>@warehouse.Code</option>
                                    }
                                    else
                                    {
                                        <option value="@warehouse.Id">@warehouse.Code</option>
                                    }
                                }
                            </select>
                        </td>
                        <td>
                            <input type="number" min="1" step="1" class="form-control form-control-sm qty-input"
                                   name="Lines[@i].Quantity" value="@(line.Quantity <= 0 ? 1 : line.Quantity)" />
                        </td>
                        <td class="text-end line-amount">0 ¥</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-line" title="Xoá dòng">×</button>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                <tr>
                    <td colspan="3" class="text-end text-muted">Tạm tính / Thuế 10% / Tổng</td>
                    <td class="text-end fw-semibold" id="order-total" colspan="2">0 ¥</td>
                </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Giá &amp; tên hàng được Ordering service lấy từ Catalog và <em>snapshot</em> vào ORDER_LINE khi lưu.
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu đơn (Draft)</button>
        <a class="btn btn-outline-secondary" asp-page="/Orders/Index">Huỷ</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/orders-create.js"></script>
}
