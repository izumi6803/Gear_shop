@page
@model StockFlow.Inventory.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">order · Đơn hàng</h1>
        <p class="text-muted small mb-0">Nghiệp vụ do <strong>Ordering service</strong> xử lý (OrderingDb).</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">Tất cả trạng thái</option>
                @foreach (var option in new[] { "Draft", "Confirmed", "Shipped", "Cancelled" })
                {
                    if (Model.Status == option)
                    {
                        <option value="@option" selected>@option</option>
                    }
                    else
                    {
                        <option value="@option">@option</option>
                    }
                }
            </select>
        </form>
        @if (Model.CanSell)
        {
            <a class="btn btn-sm btn-primary" asp-page="/Orders/Create">+ Tạo đơn</a>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Số đơn</th>
                <th>Khách hàng</th>
                <th>Ngày</th>
                <th class="text-end">Dòng</th>
                <th class="text-end">Tạm tính</th>
                <th class="text-end">Thuế 10%</th>
                <th class="text-end">Tổng</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Orders.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">Không có đơn hàng.</td></tr>
            }
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td class="fw-semibold">@order.OrderNo</td>
                    <td>@order.CustomerName</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@order.Lines.Count</td>
                    <td class="text-end">@order.SubTotal.ToString("N0")</td>
                    <td class="text-end">@order.TaxAmount.ToString("N0")</td>
                    <td class="text-end fw-semibold">@order.TotalAmount.ToString("N0") ¥</td>
                    <td><span class="badge @Badge(order.Status)">@order.Status</span></td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            @if (Model.CanSell && order.Status == "Draft")
                            {
                                <form method="post" asp-page-handler="Confirm" asp-route-status="@Model.Status">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button class="btn btn-sm btn-outline-primary">Xác nhận</button>
                                </form>
                            }
                            @if (Model.CanSell && order.Status == "Confirmed")
                            {
                                <form method="post" asp-page-handler="Ship" asp-route-status="@Model.Status">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button class="btn btn-sm btn-outline-success">Xuất kho</button>
                                </form>
                            }
                            @if (Model.CanSell && order.Status is "Draft" or "Confirmed")
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-status="@Model.Status"
                                      onsubmit="return confirm('Huỷ đơn @order.OrderNo?');">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Huỷ</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private static string Badge(string status) => status switch
    {
        "Draft" => "text-bg-secondary",
        "Confirmed" => "text-bg-info",
        "Shipped" => "text-bg-success",
        "Cancelled" => "text-bg-danger",
        _ => "text-bg-light"
    };
}
