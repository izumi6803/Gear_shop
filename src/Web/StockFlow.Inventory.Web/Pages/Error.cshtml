@page
@model ErrorModel
@{
    ViewData["Title"] = "Có lỗi";
}

<div class="text-center py-5">
    <h1 class="h3">Đã xảy ra lỗi</h1>
    <p class="text-muted">Vui lòng thử lại hoặc liên hệ quản trị viên.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary mt-2" asp-page="/Index">Về trang chủ</a>
</div>
