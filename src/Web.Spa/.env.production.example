# Bản mẫu biến môi trường cho build production (Vercel).
# Sao chép thành .env.production.local hoặc khai báo trong Vercel Project Settings → Environment Variables.
#
# Để trống (hoặc không khai báo) thì SPA gọi đường dẫn tương đối /ordering-api và /catalog-api
# — chỉ đúng khi có reverse proxy cùng domain (ví dụ chạy sau Nginx).
#
# Khi deploy frontend lên Vercel, BẮT BUỘC trỏ tới backend công khai:
VITE_ORDERING_BASE=https://your-ordering-api.example.com
VITE_CATALOG_BASE=https://your-catalog-api.example.com
